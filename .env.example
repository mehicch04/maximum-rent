# ── Supabase (Project Settings → Database → Connection string) ──
# Pooled connection (used by the running app):
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma migrations):
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"

# ── Email (https://resend.com → API Keys) ──
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
INQUIRY_TO_EMAIL="info@maximum-rent.com"
INQUIRY_FROM_EMAIL="rezervacije@maximum-rent.com"

# ── Public ──
NEXT_PUBLIC_SITE_URL="https://maximum-rent.com"

# ── Supabase Storage (admin upload slika vozila) ──
# Project Settings → API. URL je https://<ref>.supabase.co
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"
