// =============================================================================
//  Maximum Rent a Car — Prisma schema (PostgreSQL / Supabase)
//  npx prisma migrate dev --name init && npx prisma generate
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (app)
  directUrl = env("DIRECT_URL") // direct (migrations)
}

enum CarClass {
  CITY_CAR
  ECONOMY
  COMPACT
  MIDSIZE
  FULLSIZE
  LUXURY
  SUV
  VAN
  MINIBUS
}

// Filterable vehicle types. A car can belong to several at once
// (e.g. a luxury sedan = [LIMUZINA, LUXURY]).
enum CarCategory {
  LIMUZINA
  LUXURY
  SUV
  COUPE
  COMPACT
  KARAVAN
  CABRIO
  TRANSPORT
  MINIBUS
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
}

enum LocationType {
  HEAD_OFFICE
  AIRPORT
  BUS_STATION
  CITY_OFFICE
}

enum InquiryChannel {
  EMAIL
  WHATSAPP
}

enum InquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum Locale {
  HR
  EN
}

model Location {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  type       LocationType @default(CITY_OFFICE)
  street     String
  city       String
  postalCode String
  latitude   Float?
  longitude  Float?
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  pickupInquiries Inquiry[] @relation("PickupLocation")
  returnInquiries Inquiry[] @relation("ReturnLocation")

  @@index([isActive, sortOrder])
}

model Car {
  id            String       @id @default(cuid())
  slug          String       @unique
  brand         String
  model         String
  title         String
  year          Int
  carClass      CarClass
  categories    CarCategory[] @default([])
  transmission  Transmission
  passengers    Int
  doors         Int          @default(4)
  fuelType      FuelType
  emissionClass String?
  luggage       Int?
  airCondition  Boolean      @default(true)
  pricePerDay   Decimal?     @db.Decimal(10, 2)
  /// Optional in-season rate. Used only while seasonal pricing is switched on;
  /// cars without one keep their regular rate, so nothing is ever left unpriced.
  seasonalPrice Decimal?     @db.Decimal(10, 2)
  currency      String       @default("BAM")
  deposit       Decimal?     @db.Decimal(10, 2)
  images        String[]
  descriptionHr String?
  descriptionEn String?
  isAvailable   Boolean      @default(true)
  isFeatured    Boolean      @default(false)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  inquiries Inquiry[]
  blocks    CarBlock[]

  @@index([carClass, isAvailable])
  @@index([isFeatured, sortOrder])
}

model Inquiry {
  id        String @id @default(cuid())
  reference String @unique @default(cuid())

  car              Car?    @relation(fields: [carId], references: [id], onDelete: SetNull)
  carId            String?
  carTitleSnapshot String?

  pickupLocation   Location? @relation("PickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupLocationId String?
  returnLocation   Location? @relation("ReturnLocation", fields: [returnLocationId], references: [id], onDelete: SetNull)
  returnLocationId String?

  pickupAt DateTime
  returnAt DateTime

  firstName    String
  lastName     String
  email        String
  phone        String
  flightNumber String?
  message      String?

  channel InquiryChannel @default(EMAIL)
  status  InquiryStatus  @default(NEW)
  locale  Locale         @default(HR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([carId])
  // Fast overlap lookups for availability (CONFIRMED reservations only).
  @@index([carId, status, pickupAt, returnAt])
  /// Price agreed at booking time: rental plus extras. Stored rather than
  /// recomputed, so changing a car's rate later never rewrites past bookings
  /// or the reports built from them.
  totalPrice Decimal?      @db.Decimal(10, 2)
  /// Rental length in whole days, kept alongside the price for reporting.
  rentalDays Int?

  extras     InquiryExtra[]

}

// Manual unavailability window for a car (service, damage, internal use).
// Day-granularity: [startAt, endAt) in UTC. Treated exactly like a CONFIRMED
// reservation when computing availability. Kept as a small dedicated model
// instead of a client-less Inquiry so inquiry validation stays strict.
model CarBlock {
  id        String   @id @default(cuid())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId     String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([carId, startAt, endAt])
}

// General contact / business inquiries sent from the website forms.
// Separate from `Inquiry` (which is reservation-specific and requires dates).
model ContactRequest {
  id        String   @id @default(cuid())
  reference String   @unique @default(cuid())
  type      String   @default("CONTACT") // CONTACT | BUSINESS
  firstName String
  lastName  String
  email     String
  phone     String
  company   String?
  message   String?
  status    String   @default("NEW")
  locale    Locale   @default(HR)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Brute-force protection for the admin login. One row per client IP.
// Written on failed attempts, cleared on success, and read on every attempt.
model AdminLoginAttempt {
  ip          String    @id
  failedCount Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

// Simple key/value store for site-wide settings (e.g. primary currency).
model Setting {
  key   String @id
  value String
}

/// How an extra is charged. INCLUDED items cost nothing but are still worth
/// showing — "second driver included" strengthens the offer.
enum ExtraPricing {
  PER_DAY
  PER_RENTAL
  INCLUDED
}

/// Optional equipment / services the guest can request with a booking
/// (child seat, additional driver, cross-border permit, ...). Managed by the
/// owner in the admin panel.
model Extra {
  id         String       @id @default(cuid())
  nameHr     String
  nameEn     String
  noteHr     String?
  noteEn     String?
  pricing    ExtraPricing @default(PER_DAY)
  price      Decimal      @default(0) @db.Decimal(10, 2)
  /// 1 = simple yes/no. Above 1 the guest picks a quantity (e.g. 3 child seats).
  maxQty     Int          @default(1)
  /// How many pieces exist in total. Used to work out how many are still free
  /// for a given period, so the same seat is never promised twice.
  totalStock Int          @default(1)
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  inquiries  InquiryExtra[]

  @@index([isActive, sortOrder])
}

/// Extras chosen on one inquiry. Name and price are copied over so an old
/// inquiry still reads correctly after the owner edits or deletes the extra.
model InquiryExtra {
  id        String       @id @default(cuid())
  inquiry   Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId String
  extra     Extra?       @relation(fields: [extraId], references: [id], onDelete: SetNull)
  extraId   String?
  nameHr    String
  nameEn    String
  pricing   ExtraPricing
  unitPrice Decimal      @default(0) @db.Decimal(10, 2)
  qty       Int          @default(1)

  @@index([inquiryId])
}


/// Company details the owner can edit himself: contacts, working hours,
/// rating and social links. Exactly one row is kept (id = "main"); the code
/// falls back to sensible defaults while it does not exist yet.
model CompanyInfo {
  id           String   @id @default("main")
  name         String
  email        String
  phone1       String
  phone1Label  String   @default("Tel")
  phone2       String?
  phone2Label  String   @default("Mob")
  phone3       String?
  phone3Label  String   @default("Fax")
  /// Digits only, E.164 without the plus (used to build wa.me links).
  whatsapp     String
  hours        String
  mapLat       Float?
  mapLng       Float?
  mapLink      String?
  ratingScore  Float?
  ratingCount  Int?
  facebook     String?
  instagram    String?
  /// While true, cars that have a seasonal rate are offered at that rate.
  seasonalPricing Boolean @default(false)
  updatedAt    DateTime @updatedAt
}
